{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinamoosazadeh/crypto-historical-pair-data-bank/schemas/artifact-manifest.schema.json",
  "title": "Concrete historical market data artifact manifest record",
  "type": "object",
  "required": ["artifact_id", "source_id", "canonical_url", "observed_at_utc", "verification_state"],
  "properties": {
    "artifact_id": {"type": "string"},
    "source_id": {"type": "string"},
    "venue_id": {"type": ["string", "null"]},
    "market_type": {"type": ["string", "null"]},
    "provider_symbol": {"type": ["string", "null"]},
    "dataset_family": {"type": ["string", "null"]},
    "interval": {"type": ["string", "null"]},
    "partition_key": {"type": ["string", "null"]},
    "canonical_url": {"type": "string", "format": "uri"},
    "final_url": {"type": ["string", "null"]},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "http_status": {"type": ["integer", "null"]},
    "bytes": {"type": ["integer", "null"], "minimum": 0},
    "checksum_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "format": {"type": ["string", "null"]},
    "compression": {"type": ["string", "null"]},
    "row_count": {"type": ["integer", "null"], "minimum": 0},
    "row_count_method": {"type": ["string", "null"]},
    "first_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "last_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "timestamp_unit": {"enum": ["s", "ms", "us", "ns", null]},
    "verification_state": {"type": "string"},
    "terms_status": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
