{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinamoosazadeh/crypto-historical-pair-data-bank/schemas/source.schema.json",
  "title": "Historical market data source",
  "type": "object",
  "required": ["source_id", "name", "status", "landing_url", "verification_state"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "name": {"type": "string", "minLength": 2},
    "source_class": {"type": "string"},
    "status": {"enum": ["qualified_candidate", "conditional", "out_of_scope_or_unverified", "needs_review"]},
    "market_scope": {"type": "string"},
    "data_families": {"type": "array", "items": {"type": "string"}},
    "data_levels": {"type": "array", "items": {"type": "string"}},
    "landing_url": {"type": "string", "format": "uri"},
    "download_url": {"type": "string"},
    "last_reviewed": {"type": "string", "format": "date"},
    "verification_state": {"type": "string"},
    "confidence": {"type": "string"}
  },
  "additionalProperties": true
}
